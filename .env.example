# Claude API (Understand step: NL -> structured intent JSON)
ANTHROPIC_API_KEY=

# RouteStack (Travel Booking MCP API) partner credentials.
# apiKey is the public partner identifier; secretKey signs the HMAC used to
# mint a short-lived bearer token from POST /mcp/auth/partner-token.
# See docs/EXTERNAL_MCP_INTEGRATION.md (RouteStack's own docs) for details.
ROUTESTACK_BASE_URL=https://mcp.routestack.ai
ROUTESTACK_API_KEY=
ROUTESTACK_SECRET_KEY=

PORT=3000

# Postgres connection string (sessions, reservations, saved_preferences).
# A free Neon (neon.tech) or Supabase (supabase.com) project works well -
# both give you this exact connection-string format, no local install
# needed. Not required to start the server (nothing in /chat or /reserve
# uses the DB yet); required for `npm run db:migrate`.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
