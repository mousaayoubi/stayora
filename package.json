{
  "name": "stayora",
  "version": "0.1.0",
  "description": "Stayora: a premium agentic hotel booking assistant that searches, explains, verifies, and reserves in one trusted conversation.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp-server": "node src/mcp/routeStackServer.js",
    "index": "node src/rag/buildIndex.js",
    "db:migrate": "node src/db/migrate.js",
    "client:install": "npm install --prefix client",
    "client:dev": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
